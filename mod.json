{
    "geode": "5.8.2",
    "gd": {
        "android": "2.2081"
    },
    "id": "com.yourname.cyrillictest",
    "name": "RU Mod Descriptions",
    "version": "v1.0.7",
    "developer": "YourName",
    "description": "Translates mod description popups into Russian using a custom Cyrillic font.",
    "resources": {
        "fonts": {
            "PusiaCyrillic": {
                "path": "resources/Pusia-Bold.ttf",
                "size": 80,
                "charset": "32-126,1024-1279"
            }
        }
    },
    "settings": {
        "enabled": {
            "name": "Enabled",
            "description": "Turn translation on or off.",
            "type": "bool",
            "default": true
        }
    }
}
