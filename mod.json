{
    "geode": "5.8.2",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "com.yourname.cyrillictest",
    "name": "RU-Descriptions",
    "version": "1.0.0",
    "developer": "semionhot",
    "description": "Translates mod description popups into Russian, using a texture pack to make Geode's own markdown renderer support Cyrillic.",
    "tags": [
        "online",
        "enhancement",
        "utility",
        "interface"
    ],
    "dependencies": {
        "geode.texture-loader": ">=1.0.0"
    },
    "resources": {
        "files": [
            "resources/texturepack/pack.json",
            "resources/texturepack/**/*.fnt",
            "resources/texturepack/**/*.png"
        ]
    },
    "settings": {
        "enabled": {
            "name": "Enabled",
            "description": "Turn translation on or off.",
            "type": "bool",
            "default": true
        },
        "translator": {
            "name": "Translator",
            "description": "Which service translates descriptions. \"None\" just shows the original English text - useful to confirm the font pack itself works.",
            "type": "string",
            "default": "google",
            "one-of": ["google", "mymemory", "none"]
        }
    }
}
